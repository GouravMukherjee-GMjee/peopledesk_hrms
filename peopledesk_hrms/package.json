{
  "name": "people-desk-hrms",
  "version": "2.1.0",
  "private": true,
  "description": "PeopleDesk HRMS: attendance, leave, payroll, shifts, safety and training for office and plant teams.",
  "scripts": {
    "build": "node scripts/build.js",
